# Copy this file to secrets.toml (same folder) for local testing, or paste
# these into Streamlit Community Cloud's "Secrets" box for the deployed app.
# NEVER commit the real secrets.toml — it's already in .gitignore.
#
# Leave these three unset (or delete this file / don't add secrets on Cloud)
# to run the app in local-only mode instead, with the Excel-workbook backend.

SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY = "eyJhbGciOi...your-anon-public-key..."

# Optional — only set these if you used different table names than the
# defaults when running the setup SQL from PACKAGING.md / README.
# SUPABASE_TABLE = "internships"
# SUPABASE_SETTINGS_TABLE = "app_settings"
